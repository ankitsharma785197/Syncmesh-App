    <!-- Mesh edges: a complete graph between three outer devices and a central hub,
         evoking a peer-to-peer sync mesh. Drawn first so the nodes sit on top. -->
    <path
        android:pathData="M54,56 L54,29 M54,56 L29,73 M54,56 L79,73 M54,29 L29,73 M54,29 L79,73 M29,73 L79,73"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeAlpha="0.92"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Outer device nodes. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,29 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 z
                          M21,73 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 z
                          M71,73 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 z" />

    <!-- Central hub node (slightly larger, with an emerald core for depth). -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,56 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 z" />
    <path
        android:fillColor="#059669"
        android:pathData="M49,56 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 z" />
