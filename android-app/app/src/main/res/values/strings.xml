    <string name="tour_replay">Replay tour</string>
    <string name="tour_finish">Finish</string>

    <!-- Guided action tour steps -->
    <string name="tour_sync_title">Start syncing</string>
    <string name="tour_sync_desc">Tap Start Sync on every device you want to connect. A quiet notification keeps sync running in the background.</string>
    <string name="tour_kb_enable_title">Enable the keyboard</string>
    <string name="tour_kb_enable_desc">Turn on the SyncMesh keyboard in Android settings. Android 10+ needs an active keyboard to send your clipboard reliably.</string>
    <string name="tour_kb_choose_title">Choose the keyboard</string>
    <string name="tour_kb_choose_desc">Open the keyboard switcher and set SyncMesh as your active input method.</string>
    <string name="tour_qr_show_title">Show your QR code</string>
    <string name="tour_qr_show_desc">Display this device\'s pairing QR so another phone can scan it. Start sync first so the code is live.</string>
    <string name="tour_qr_scan_title">Scan to connect</string>
    <string name="tour_qr_scan_desc">Point your camera at another device\'s QR code to auto-fill its address and pairing code.</string>
    <string name="tour_connect_title">Connect manually</string>
    <string name="tour_connect_desc">No QR? Type the other device\'s IP address, port and 6-digit code, then tap Pair Device.</string>
    <string name="tour_devices_title">Your trusted devices</string>
    <string name="tour_devices_desc">Paired devices live here. Ping one to test the link, or remove it any time.</string>
    <string name="tour_history_title">Clipboard history</string>
    <string name="tour_history_desc">Search and filter everything copied or received. Tap any entry to copy it again.</string>
