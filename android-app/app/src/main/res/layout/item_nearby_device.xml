<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Syncmesh.Card.Interactive"
    android:layout_marginTop="@dimen/card_spacing">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding_compact">

        <FrameLayout
            android:layout_width="@dimen/avatar_md"
            android:layout_height="@dimen/avatar_md"
            android:background="@drawable/bg_icon_secondary">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:layout_gravity="center"
                android:contentDescription="@string/pair_nearby_title"
                app:srcCompat="@drawable/ic_nearby"
                app:tint="?attr/colorSecondary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_device_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Syncmesh.Subtitle"
                android:textStyle="bold"
                tools:text="Galaxy S23" />

            <TextView
                android:id="@+id/text_device_endpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textAppearance="@style/TextAppearance.Syncmesh.Caption"
                tools:text="192.168.1.7:8989" />

            <TextView
                android:id="@+id/text_device_seen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Syncmesh.Caption"
                tools:text="Seen just now" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_use"
            style="@style/Widget.Syncmesh.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/action_use_device"
            app:icon="@drawable/ic_add" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
