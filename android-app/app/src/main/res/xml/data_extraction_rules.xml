<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (API 31+). Sensitive SyncMesh data is excluded from both cloud backup
   and device-to-device transfer so the pairing code and clipboard history are not copied off
   the device. Keyboard (HeliBoard) settings in the default preferences are left intact.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="syncmesh.db" />
        <exclude domain="sharedpref" path="syncmesh_prefs.xml" />
        <exclude domain="sharedpref" path="syncmesh_keyboard_bridge.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="syncmesh.db" />
        <exclude domain="sharedpref" path="syncmesh_prefs.xml" />
        <exclude domain="sharedpref" path="syncmesh_keyboard_bridge.xml" />
    </device-transfer>
</data-extraction-rules>
