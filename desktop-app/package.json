{
  "name": "syncmesh-desktop",
  "productName": "SyncMesh Desktop",
  "version": "2.0.0",
  "description": "Offline clipboard sync and file transfer between Android, Windows and macOS over local network.",
  "main": "main.js",
  "author": "SyncMesh",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "electron-log": "^5.2.4",
    "qrcode": "^1.5.4",
    "sql.js": "^1.12.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.syncmesh.desktop",
    "productName": "SyncMesh Desktop",
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!node_modules/.cache",
      "!**/test",
      "!**/*.log"
    ],
    "win": {
      "icon": "assets/icon-512.png",
      "publisherName": "SyncMesh",
      "artifactName": "syncmesh-windows-v${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "assets/icon-512.png",
      "artifactName": "syncmesh-mac-${arch}-v${version}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    }
  }
}
